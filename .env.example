# Ordinary development and tests: no credentials, trust roots, or digests required.
NAPPLET_CVM_CERTIFIER_CONFIG=./config/certifier.local.json

# Protected release material is generated by the controller after one provider
# authentication and approval of its cost/effect digest. Do not set profile,
# registry, trust-root, observation, or evidence-path environment variables.
# `release:certify` defaults to .runtime/release-certification. Optional
# NAPPLET_CVM_RELEASE_WORKSPACE must be an absolute path under that directory.
