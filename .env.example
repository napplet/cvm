# Ordinary development and tests: no credentials, trust roots, or digests required.
NAPPLET_CVM_CERTIFIER_CONFIG=./config/certifier.local.json

# Protected release environments replace the line above with an absolute path
# to an operator-owned mode=protected JSON file and pin its exact bytes:
# NAPPLET_CVM_CERTIFIER_CONFIG=/run/secrets/napplet-cvm/certifier.json
# NAPPLET_CVM_CERTIFIER_CONFIG_SHA256=<sha256-of-that-file>
