{
  "name": "napplet-cvm",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "release:certify": "bun scripts/certify-release.ts",
    "test": "bun test",
    "pricing:sync": "bun scripts/sync-development-rates.ts",
    "test:design-slice": "bun run scripts/verify-design-slice.ts",
    "test:promotion": "bun run scripts/test-promotion.ts",
    "toolchain:image-build": "bun run scripts/build-toolchain-image.ts",
    "candidate:detect": "bun run src/promotion/candidate.ts",
    "candidate:verify": "bun run src/promotion/candidate.ts",
    "release:verify:protected": "bun run scripts/verify-phase-07-release.ts",
    "candidate:workflow-check": "bun test tests/promotion/candidate.test.ts --test-name-pattern='candidate workflow'",
    "test:modal-probe": "bun run scripts/probe-modal-worker.ts",
    "eval:phase-02": "bun test tests/evals/phase-02-reference-set.test.ts",
    "eval:phase-03": "bun test tests/evals/phase-03-reference-set.test.ts",
    "eval:phase04": "bun test tests/evals/phase-04-reference-set.test.ts --timeout 10000",
    "verify:phase04-design": "bun run scripts/verify-phase-04-design-slice.ts",
    "eval:phase05": "bun test tests/evals/phase-05-reference-set.test.ts --timeout 10000",
    "verify:phase05-design": "bun run scripts/verify-phase-05-design-slice.ts",
    "probe:phase06-cli-source": "bun run scripts/probe-phase-06-cli-source-contract.ts",
    "eval:phase06": "bun test tests/evals/phase-06-reference-set.test.ts --timeout 10000",
    "verify:phase06-design": "bun run scripts/verify-phase-06-design-slice.ts",
    "eval:phase07": "bun run scripts/eval-phase-07.ts -- --suite=all",
    "verify:phase07-evidence": "bun run scripts/verify-phase-07-evidence.ts",
    "certify:phase07": "bun run scripts/certify-phase-07.ts",
    "test:phase-03-design-slice": "bun run scripts/verify-phase-03-design-slice.ts",
    "test:phase-02-design-slice": "bun run scripts/verify-phase-02-design-slice.ts"
  },
  "dependencies": {
    "@cashu/cashu-ts": "4.7.2",
    "@contextvm/sdk": "0.13.10",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "applesauce-core": "6.2.0",
    "applesauce-loaders": "6.2.0",
    "applesauce-relay": "6.2.1",
    "applesauce-signers": "6.2.3",
    "google-auth-library": "11.3.1",
    "kysely": "0.29.4",
    "modal": "0.9.0",
    "nostr-tools": "2.24.1",
    "pg": "8.22.0",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  },
  "patchedDependencies": {
    "@contextvm/sdk@0.13.10": "patches/@contextvm%2Fsdk@0.13.10.patch"
  }
}
